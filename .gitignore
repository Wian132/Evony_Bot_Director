# ── secrets ───────────────────────────────────────────────────────────────
# .env holds the console's account login; evony.db holds every account's
# password in the accounts table. Neither ever belongs in the repo.
.env
*.db
*.db-wal
*.db-shm
accounts.json
proxies.txt
*proxies*.txt
json-backup/

# ── third-party ───────────────────────────────────────────────────────────
# Decompiled Evony client source. Kept locally as the authority for command and
# field names, but it is someone else's copyrighted code — not ours to publish.
src/
ffdec.zip
ffdec/
*.swf

# ── capture and scratch ───────────────────────────────────────────────────
*.pcap
payloads*.txt
p2.txt
payload*.json
*.log
*.log.*
snapshots.json
watchlist.json
goalstore.json
scriptstore.json
enginestate.json
mapcache.json

dbg.json
itemdefs.json
itemcatalog.json
ik.txt
ck.txt

# ── the user's own script files ───────────────────────────────────────────
# What `call` and `get` read, the sounds `play` plays, and NEAT's startup
# parameters (script-console.js). Each install's own, like its loadouts.
/scripts/
/media/
/CmdParms.txt

node_modules/

# ── large/local-only, kept out of the repo by request ─────────────────────
/Images/
/resource-records/

# ── this install's private data ───────────────────────────────────────────
# privacy.local.json maps the aliases (Lord01 …) used in tracked files to the real
# in-game names; CLAUDE.local.md is this install's own notes for Claude. See privacy.js.
privacy.local.json
CLAUDE.local.md
# Goal backups and prepend files are live goal scripts with real lord names in them
# (`if u == "…"`); a scrubbed copy would restore wrong, so they stay local.
goals-backup-*
prepend-goals.txt
prepend-capture-*.txt
*.bak-*
*.pid
# What a Claude key did to the consoles (claude-guard.js audit, logs/claude-actions.jsonl):
# account names and script text, so it stays on this machine.
/logs/
# Live run data from the capture/NPC drives (account ids, lord names, stock): local.
capture-marks.json
npc-drive-plan.json
stone-audit.json
goals-prepend-*.txt
